# Media files are ignored everywhere except under website/

# Images
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tif
*.tiff
*.webp
*.svg
*.ico
*.heic
*.heif
*.raw
*.cr2
*.nef
*.arw
*.dng
*.psd
*.ai
*.eps
*.exr
*.hdr
*.ppm
*.pgm
*.pbm
*.pnm

# Video
*.mp4
*.m4v
*.mov
*.avi
*.mkv
*.wmv
*.flv
*.webm
*.mpg
*.mpeg
*.3gp
*.ogv

# Audio
*.mp3
*.wav
*.flac
*.aac
*.ogg
*.oga
*.m4a
*.wma
*.aiff
*.aif
*.opus
*.mid
*.midi

# Re-include everything under website/ (site media is tracked)
!website/**

# Website build artifacts
website/_site/
website/.sass-cache/
website/.jekyll-cache/
website/.jekyll-metadata
website/.bundle/
website/vendor/
website/node_modules/
website/package-lock.json

# Python
__pycache__/

# Submission packages (zip, pdf)
submission/
submissions/
